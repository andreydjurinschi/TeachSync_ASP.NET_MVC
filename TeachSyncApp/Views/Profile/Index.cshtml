@model TeachSyncApp.ViewModels.UserViewModels.ProfileViewModel

<div class="card p-4">
    <p class="card-text">
        Имя: @Model.Name
        <button class="btn btn-sm btn-outline-primary ms-2" data-bs-toggle="modal" data-bs-target="#editNameModal">✏️ изменить</button>
    </p>

    <p class="card-text">
        Фамилия: @Model.Surname
        <button class="btn btn-sm btn-outline-primary ms-2" data-bs-toggle="modal" data-bs-target="#editSurnameModal">✏️ изменить</button>
    </p>

    <p class="card-text">
        Email: @Model.Email
        <button class="btn btn-sm btn-outline-primary ms-2" data-bs-toggle="modal" data-bs-target="#editEmailModal">✏️ изменить</button>
    </p>

    <p class="card-text">
        Пароль: ••••••••
        <button class="btn btn-sm btn-outline-primary ms-2" data-bs-toggle="modal" data-bs-target="#editPasswordModal">✏️ изменить</button>
    </p>
</div>

<!-- Модальное окно: Имя -->
<div class="modal fade" id="editNameModal" tabindex="-1" aria-labelledby="editNameLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="EditProfile" method="post">
                <div class="modal-header">
                    <h5 class="modal-title" id="editNameLabel">Изменить имя</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
                </div>
                <div class="modal-body">
                    <input type="text" name="name" class="form-control" value="@Model.Name" required />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отмена</button>
                    <button type="submit" class="btn btn-primary">Сохранить</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Модальное окно: Фамилия -->
<div class="modal fade" id="editSurnameModal" tabindex="-1" aria-labelledby="editSurnameLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="EditProfile" method="post">
                <div class="modal-header">
                    <h5 class="modal-title" id="editSurnameLabel">Изменить фамилию</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
                </div>
                <div class="modal-body">
                    <input type="text" name="surname" class="form-control" value="@Model.Surname" required />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отмена</button>
                    <button type="submit" class="btn btn-primary">Сохранить</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Модальное окно: Email -->
<div class="modal fade" id="editEmailModal" tabindex="-1" aria-labelledby="editEmailLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="EditProfile" method="post">
                <div class="modal-header">
                    <h5 class="modal-title" id="editEmailLabel">Изменить email</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
                </div>
                <div class="modal-body">
                    <input type="email" name="email" class="form-control" value="@Model.Email" required />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отмена</button>
                    <button type="submit" class="btn btn-primary">Сохранить</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Модальное окно: Пароль -->
<div class="modal fade" id="editPasswordModal" tabindex="-1" aria-labelledby="editPasswordLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="EditProfile" method="post">
                <div class="modal-header">
                    <h5 class="modal-title" id="editPasswordLabel">Изменить пароль</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
                </div>
                <div class="modal-body">
                    <input type="password" name="password" class="form-control" required />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отмена</button>
                    <button type="submit" class="btn btn-primary">Сохранить</button>
                </div>
            </form>
        </div>
    </div>
</div>
