@model TeachSyncApp.ViewModels.Replacement.ReplacementStatisticsViewModel

<div class="container mt-4">
    <h1 class="mb-4">Replacement Statistics</h1>


    <div class="btn-group mb-4" role="group" aria-label="Filter by status">
        <a class="btn btn-outline-primary" asp-action="GetReplacementsData" asp-route-status="pending">Pending</a>
        <a class="btn btn-outline-success" asp-action="GetReplacementsData" asp-route-status="approved">Approved</a>
        <a class="btn btn-outline-danger" asp-action="GetReplacementsData" asp-route-status="rejected">Rejected</a>
        <a class="btn btn-outline-secondary" asp-action="GetReplacementsData">All</a>
    </div>


    <h2 class="text-success mt-4">Approved Replacements</h2>
    @if (Model.AppliedReplacements.Any())
    {
        <div class="row row-cols-1 row-cols-md-2 g-4">
            @foreach (var applied in Model.AppliedReplacements)
            {
                var schedule = applied.Replacement?.Schedule;
                <div class="col">
                    <div class="card border-success">
                        <div class="card-header bg-success text-white">
                            Teacher accepted: @applied.Teacher?.Name @applied.Teacher?.Surname
                        </div>
                        <div class="card-body">
                            <p><b>Group:</b> @schedule?.GroupCourse?.Group?.Name</p>
                            <p><b>Course:</b> @schedule?.GroupCourse?.Course?.Name</p>
                            <p><b>Time:</b> @schedule?.StartTime - @schedule?.EndTime</p>
                            <p><b>Day:</b> @schedule?.WeekDays?.Name</p>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <h2 class="text-danger mt-5">Rejected Replacements</h2>
    @if (Model.RejectedReplacements.Any())
    {
        <div class="row row-cols-1 row-cols-md-2 g-4">
            @foreach (var rejected in Model.RejectedReplacements)
            {
                var schedule = rejected.Replacement?.Schedule;
                <div class="col">
                    <div class="card border-danger">
                        <div class="card-header bg-danger text-white">
                            Teacher rejected: @rejected.Teacher?.Name @rejected.Teacher?.Surname
                        </div>
                        <div class="card-body">
                            <p><b>Group:</b> @schedule?.GroupCourse?.Group?.Name</p>
                            <p><b>Course:</b> @schedule?.GroupCourse?.Course?.Name</p>
                            <p><b>Time:</b> @schedule?.StartTime - @schedule?.EndTime</p>
                            <p><b>Day:</b> @schedule?.WeekDays?.Name</p>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <h2 class="text-warning mt-5">Pending Replacements</h2>
    @if (Model.PendingReplacements.Any())
    {
        <div class="row row-cols-1 row-cols-md-2 g-4">
            @foreach (var r in Model.PendingReplacements)
            {
                <div class="col">
                    <div class="card border-warning">
                        <div class="card-header bg-warning text-dark">
                            Teacher sent: @r.Schedule.Teacher.Name @r.Schedule.Teacher.Surname
                        </div>
                        <div class="card-body">
                            <p><b>Group:</b> @r.Schedule?.GroupCourse.Group.Name</p>
                            <p><b>Course:</b> @r.CourseTopic?.Course?.Name</p>
                            <p><b>Topics:</b> @r.CourseTopic?.Topic?.Name</p>
                            <p><b>Time:</b> @r.Schedule?.StartTime - @r.Schedule?.EndTime</p>
                            <p><b>Day:</b> @r.Schedule?.WeekDays?.Name</p>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
