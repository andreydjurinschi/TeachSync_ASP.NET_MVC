@model IEnumerable<Group>

<a asp-controller="Group" asp-action="Create" class="p-2">Create new Group</a>
<table class="table table-striped table-hover">
    <thead>
    <tr>
        <th>@Html.DisplayNameFor(model => model.Name)</th>
        <th>@Html.DisplayNameFor(model => model.Year)</th>
        <th>@Html.DisplayNameFor(model => model.Capacity)</th>
        <th>@Html.DisplayNameFor(model => model.GroupCourses)</th>
        <th>Teacher</th>
        <th>Details</th>
        <th>Add Course</th>
        <th>Edit</th>
        <th>Delete</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Year)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Capacity)
            </td>
            <td colspan="2">
                @if (item.GroupCourses.Any())
                {
                    <ul class="list-unstyled">
                        @foreach (var courseTopic in item.GroupCourses)
                        {
                            <li class="d-flex justify-content-between align-items-center">
                    <span>
                        @courseTopic.Course.Name
                    </span>
                                <form asp-controller="GroupCourse"
                                      asp-action="DeleteCourseFromGroup"
                                      asp-route-groupId="@item.Id"
                                      asp-route-courseId="@courseTopic.CourseId"
                                      method="post"
                                      class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this course?')">
                                        <i class="bi bi-x-circle"></i> Remove
                                    </button>
                                </form>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p>No courses assigned</p>
                }
            </td>

            <td>
                @if (item.GroupCourses.Any())
                {
                    <ul>
                        @foreach (var courseTopic in item.GroupCourses)
                        {
                            <li>@courseTopic.Course.User?.Name @courseTopic.Course.User?.Surname</li>
                        }
                    </ul>
                }
                else
                {
                    <p>No teacher for this group</p>
                }
            </td>
            <td>
                <a asp-action="Details" asp-route-id="@item.Id">Details</a>
            </td>
            <td>
                <a asp-controller="GroupCourse" asp-action="CreateGet" asp-route-id="@item.Id">Add course</a>
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a>
            </td>            
            <td>
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>