@model TeachSyncApp.Models.Courses
@using TeachSyncApp.Models.intermediateModels

<h1 class="text-center my-4">Course Details</h1>

<div class="d-flex justify-content-center">
    <div class="card shadow-sm border-0" style="width: 34rem;">
        <div class="card-body">
            <h4 class="card-title text-center fw-bold mb-3">
                @Html.DisplayFor(model => model.Name)
            </h4>

            <ul class="list-group list-group-flush mb-3">
                <li class="list-group-item">
                    <strong>@Html.DisplayNameFor(model => model.Description):</strong>
                    <div class="ms-2">@Html.DisplayFor(model => model.Description)</div>
                </li>

                <li class="list-group-item">
                    <strong>Teacher:</strong>
                    <div class="ms-2">
                        @if (Model.TeacherId == null)
                        {
                            <span class="text-muted">No teacher assigned</span>
                        }
                        else
                        {
                            @Html.DisplayFor(model => model.User.Name) @Html.DisplayFor(model => model.User.Surname)
                        }
                    </div>
                </li>

                <li class="list-group-item">
                    <strong>Topics:</strong>
                    <div class="ms-2">
                        @if (Model.CoursesTopics.Any())
                        {
                            <ul class="mb-0 ps-3">
                                @foreach (var courseTopic in Model.CoursesTopics)
                                {
                                    <li>@courseTopic.Topic.Name</li>
                                }
                            </ul>
                        }
                        else
                        {
                            <span class="text-muted">No topics assigned</span>
                        }
                    </div>
                </li>
            </ul>

            <div class="d-flex justify-content-between mt-4">
                <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.Id">
                    Edit Course
                </a>
                <a class="btn btn-secondary" asp-action="Index">
                    Back to Courses
                </a>
            </div>
        </div>
    </div>
</div>
