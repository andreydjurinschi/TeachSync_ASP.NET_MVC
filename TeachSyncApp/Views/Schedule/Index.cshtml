@model IEnumerable<Schedule>

<!--<a asp-controller="Schedule" asp-action="Create" class="btn btn-primary mb-3">Create Schedule</a>-->

<table class="table table-bordered table-hover">
    <thead class="thead-dark">
    <tr class="text-center">
        <th>Teacher</th>
        <th>Group</th>
        <th>Course</th>
        <th>Start</th>
        <th>End</th>
        <th>Classroom</th>
        <th>Weekday</th>
        <th>Actions</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Teacher.Name @item.Teacher.Surname</td>
            <td>@item.GroupCourse.Group.Name</td>
            <td>@item.GroupCourse.Course.Name</td>
            <td>@item.StartTime</td>
            <td>@item.EndTime</td>
            <td>@item.ClassRoom.Name</td>
            <td>@item.WeekDays.Name</td>
            <td class="text-center">
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>
