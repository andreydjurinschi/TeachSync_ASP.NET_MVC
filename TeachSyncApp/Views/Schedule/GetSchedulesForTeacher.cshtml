@model IEnumerable<TeachSyncApp.Models.Schedule>

@{
    ViewData["Title"] = "Teacher's Schedule";
}

<h1>Schedule</h1>

<table class="table table-striped table-hover">
    <thead>
    <tr>
        <th>Day of week</th>
        <th>Teacher</th>
        <th>Classroom</th>
        <th>Group-Course</th>
        <th>Start Time</th>
        <th>End Time</th>
        <th>Request for 
            replacement</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var schedule in Model)
    {
        <tr>
            <td>@schedule.WeekDays.Name</td>
            <td>@schedule.Teacher.Name</td>
            <td>@schedule.ClassRoom.Name</td>
            <td>@schedule.GroupCourse.Group.Name - @schedule.GroupCourse.Course.Name</td>
            <td>@schedule.StartTime.ToString("hh\\:mm")</td>
            <td>@schedule.EndTime.ToString("hh\\:mm")</td>
            <td><a asp-controller="Replacement" asp-action="CreateForm" asp-route-teacherId="@schedule.Teacher.Id" asp-route-courseId="@schedule.GroupCourse.Course.Id" class="btn btn-info">Request</a></td>
        </tr>
    }
    </tbody>
</table>

