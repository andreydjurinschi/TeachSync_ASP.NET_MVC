@using System.Security.Claims
@model List<TeachSyncApp.Models.Notification>
@{
    ViewData["Title"] = "Notifications";
}

<div class="container mt-5">
    <h2 class="mb-4">Your notifications</h2>

    @if (Model.Any())
    {
        <div class="list-group">
            @foreach (var item in Model)
            {
                <div class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="mb-1">Replacement request</h5>
                        <p class="mb-1">
                            Time: @item.Replacement.Schedule.WeekDays.Name: @item.Replacement.Schedule.StartTime - @item.Replacement.Schedule.EndTime
                        </p>
                        <p class="mb-1">
                            Teacher: @item.Replacement.Schedule.Teacher.Name
                        </p>
                        <p class="mb-1">
                            Course: @item.Schedule.GroupCourse.Course.Name
                        </p>
                        <p class="mb-1">
                            Topic: @item.Replacement.CourseTopic.Topic.Name
                        </p>
                        <p class="mb-1">
                            Group: @item.Schedule.GroupCourse.Group.Name
                        </p>
                          <small class="text-muted">Sent: @item.CreatedAt.ToString("dd.MM.yyyy HH:mm")</small>
                        <br>
                        <a asp-controller="Replacement" asp-action="GetApproveForm" asp-route-replacementId="@item.Replacement.Id" class="btn btn-info">Approve</a>
                        <form asp-controller="Replacement" asp-action="Reject" method="post">
                            <input type="hidden" name="replacementId" value="@item.ReplacementId" />
                            <input type="hidden" name="teacherId" value="@item.TeacherId" />
                            <button type="submit" class="btn btn-danger">Reject</button>
                        </form>

                    </div>
                    <span class="badge bg-primary">NEW</span>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info">No notifications</div>
    }
</div>